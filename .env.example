# OnchainKit / Coinbase Developer Platform API key (cdp.coinbase.com)
NEXT_PUBLIC_ONCHAINKIT_API_KEY=
# Paymaster endpoint for gasless tx (CDP)
NEXT_PUBLIC_CDP_PAYMASTER=
# BasketRegistry address (filled after base-forge deploy)
NEXT_PUBLIC_REGISTRY_ADDRESS=
# Base Builder Code (base.dev) for interaction attribution
NEXT_PUBLIC_BUILDER_CODE=
